{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension (Debug Build)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}/editors/code"
            ],
            "outFiles": [
                "${workspaceFolder}/editors/code/out/**/*.js"
            ],
            "preLaunchTask": "Build Server and Extension",
            "env": {
                "SERVER_PATH": "${workspaceRoot}/target/debug/asm-lsp"
            },
            "skipFiles": [
                "<node_internals>/**/*.js"
            ]
        },
        {
            "name": "Debug asm-lsp Program",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/asm-lsp",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Server",
        },
        {
            "name": "Attach asm-lsp Program",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/target/debug/asm-lsp",
        }
    ]
}
